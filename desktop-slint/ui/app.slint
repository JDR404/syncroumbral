// SyncroUmbral: interfaz nativa (sin WebView). Misma paleta y estructura que la versión HTML.
import { LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Theme, FileItem, Notif, NotifAction, ThreadItem, MsgItem, Photo, ContactItem, CallItem, AppItem, DeviceItem, ServiceItem, Pill, Toggle, SwitchRow, NavItem, Pane } from "common.slint";
import { NotifCard } from "notif.slint";
import { ToastWindow } from "toast.slint";

export { Theme, FileItem, Notif, NotifAction, ThreadItem, MsgItem, Photo, ContactItem, CallItem, AppItem, DeviceItem, ServiceItem, ToastWindow }

// Tarjeta de ajustes con título.
component Card inherits Rectangle {
    in property <string> title;
    background: Theme.surface;
    border-radius: 20px;
    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        if root.title != "": Text { text: root.title; font-size: 16px; color: Theme.text; }
        @children
    }
}

component AppRow inherits Rectangle {
    in property <AppItem> app;
    in property <bool> selected;
    callback clicked();
    height: 40px;
    border-radius: 14px;
    background: selected ? Theme.container : t.has-hover ? Theme.surface2 : transparent;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        Text { text: app.label; color: selected ? Theme.on-container : Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        if app.open: Text { text: "abierta en el PC"; color: Theme.ok; font-size: 12px; vertical-alignment: center; }
        if app.system: Text { text: "Sistema"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
    }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    title: "SyncroUmbral";
    icon: @image-url("icon.png");
    background: Theme.bg;
    min-width: 860px;
    min-height: 560px;
    preferred-width: 1100px;
    preferred-height: 720px;
    default-font-family: "Segoe UI";
    default-font-size: 13px;

    // ---- estado general
    in-out property <bool> locked: true;
    in-out property <int> page: 0;
    in-out property <bool> side-collapsed: false;
    in property <bool> present: false;
    in property <bool> has-password: false;
    in property <string> device;
    in property <string> device-sub;
    in property <string> lock-error;
    in property <string> lock-hint;
    in property <string> status;
    in property <string> warn;

    // ---- archivos
    in property <[FileItem]> pc-files;
    in property <[FileItem]> phone-files;
    in property <string> pc-path;
    in property <string> phone-path;
    in property <string> pc-footer;
    in property <string> pc-message;
    in property <string> phone-message;
    in property <string> phone-footer;
    in property <string> transfer-text;
    in property <float> transfer-frac;
    in property <bool> transfer-active;

    // ---- notificaciones
    in property <[Notif]> notifs;
    in property <string> notif-hint;
    in property <string> call-status;

    // ---- galería
    in property <[Photo]> photos;
    in property <string> gallery-message;
    in property <int> gallery-selected;

    // ---- mensajes SMS
    in property <[ThreadItem]> threads;
    in property <[MsgItem]> messages;
    in property <string> sms-message;
    in property <string> sms-title;
    in property <int> sms-selected: -1;

    // ---- llamadas
    in property <[ContactItem]> contacts;
    in property <[CallItem]> call-log;
    in property <string> calls-message;

    // ---- aplicaciones
    in property <[AppItem]> apps;
    in property <string> apps-message;
    in property <int> app-selected: -1;
    in-out property <bool> show-system: false;

    // ---- mensajería
    in property <[ServiceItem]> services;

    // ---- ajustes
    in property <[DeviceItem]> devices;
    in property <image> qr;
    in property <string> qr-text;
    in-out property <bool> autostart: true;
    in-out property <bool> mute-on-call: true;
    in-out property <bool> advanced: false;
    in property <string> tools-text;
    in property <bool> ringing;
    in-out property <bool> lock-windows: false;
    in-out property <bool> hide-content: false;
    in-out property <string> mute-words;
    in-out property <bool> photo-backup: false;
    in property <string> update-text;

    callback unlock(string);
    callback lock-now();
    callback pane-toggle(bool, int);
    callback pane-open(bool, int);
    callback pane-up(bool);
    callback pane-refresh(bool);
    callback send-to-phone();
    callback bring-to-pc();
    callback cancel-transfer();
    callback notif-dismiss(string);
    callback notif-reply(string, int, string);
    callback call-answer(string);
    callback call-end(string);
    callback notif-action(string, int);
    callback clear-notifs();
    callback apps-refresh();
    callback app-select(int);
    callback app-open-pc();
    callback app-action(string);
    callback web-open(int);
    callback web-forget(int);
    callback make-qr();
    callback remove-device(string);
    callback toggled-autostart(bool);
    callback toggled-mute(bool);
    callback toggled-advanced(bool);
    callback install-tool(string);
    callback page-changed(int);
    callback copy-code(string);
    callback gallery-refresh();
    callback gallery-more();
    callback gallery-toggle(int);
    callback gallery-fetch();
    callback dial(string);
    callback contacts-search(string);
    callback ring-phone(bool);
    callback send-clipboard();
    callback sms-refresh();
    callback sms-open(int);
    callback sms-send(string);
    callback toggled-lock-windows(bool);
    callback toggled-hide(bool);
    callback mute-words-edited(string);
    callback toggled-backup(bool);
    callback context-menu(bool);
    callback do-update();

    property <bool> narrow: root.side-collapsed || root.width < 980px;
    property <length> cell: 156px;
    property <int> cols: Math.max(1, Math.floor((root.width - (root.narrow ? 68px : 232px) - 70px) / root.cell));

    // ---------------------------------------------------------------- bloqueo
    if root.locked: Rectangle {
        background: @radial-gradient(circle, #1c3a3f 0%, Theme.bg 70%);
        Rectangle {
            width: 420px;
            height: 300px;
            background: #171d1ebb;
            border-radius: 20px;
            VerticalLayout {
                padding: 28px;
                spacing: 10px;
                alignment: center;
                Text { text: root.has-password ? "SyncroUmbral bloqueado" : "Crea una clave"; font-size: 22px; font-weight: 500; color: Theme.text; horizontal-alignment: center; }
                Text {
                    text: root.has-password ? root.lock-hint : "Sirve para abrir SyncroUmbral cuando no tengas el móvil cerca (mínimo 8 caracteres).";
                    color: Theme.muted;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                pw := LineEdit {
                    placeholder-text: root.has-password ? "O escribe tu clave" : "Elige una clave";
                    input-type: password;
                    accepted(t) => { root.unlock(t); }
                }
                Pill { label: root.has-password ? "Desbloquear" : "Crear clave"; clicked => { root.unlock(pw.text); pw.text = ""; } }
                Text { text: root.lock-error; color: Theme.bad; horizontal-alignment: center; wrap: word-wrap; }
            }
        }
    }

    // ---------------------------------------------------------------- principal
    if !root.locked: HorizontalLayout {
        // Panel lateral
        Rectangle {
            width: root.narrow ? 68px : 232px;
            animate width { duration: 150ms; easing: ease-out; }
            VerticalLayout {
                padding: 14px;
                padding-top: 22px;
                spacing: 6px;
                HorizontalLayout {
                    padding-bottom: 18px;
                    padding-left: 8px;
                    Text {
                        text: root.narrow ? "S" : "SyncroUmbral";
                        color: Theme.primary;
                        font-size: 20px;
                        font-weight: 500;
                        horizontal-stretch: 1;
                    }
                    if root.width >= 980px: Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: tg.has-hover ? Theme.surface : transparent;
                        Text { text: root.side-collapsed ? "›" : "‹"; color: Theme.muted; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                        tg := TouchArea { clicked => { root.side-collapsed = !root.side-collapsed; } }
                    }
                }
                NavItem { label: "Archivos"; glyph: "A"; active: root.page == 0; collapsed: root.narrow; clicked => { root.page = 0; root.page-changed(0); } }
                NavItem { label: "Notificaciones"; glyph: "N"; active: root.page == 1; badge: root.notifs.length; collapsed: root.narrow; clicked => { root.page = 1; root.page-changed(1); } }
                NavItem { label: "Galería"; glyph: "G"; active: root.page == 2; collapsed: root.narrow; clicked => { root.page = 2; root.page-changed(2); } }
                NavItem { label: "Llamadas"; glyph: "L"; active: root.page == 3; collapsed: root.narrow; clicked => { root.page = 3; root.page-changed(3); } }
                NavItem { label: "Mensajes"; glyph: "S"; active: root.page == 7; collapsed: root.narrow; clicked => { root.page = 7; root.page-changed(7); } }
                NavItem { label: "Aplicaciones"; glyph: "P"; active: root.page == 4; collapsed: root.narrow; clicked => { root.page = 4; root.page-changed(4); } }
                NavItem { label: "Mensajería"; glyph: "M"; active: root.page == 5; collapsed: root.narrow; clicked => { root.page = 5; root.page-changed(5); } }
                NavItem { label: "Móviles y ajustes"; glyph: "C"; active: root.page == 6; collapsed: root.narrow; clicked => { root.page = 6; root.page-changed(6); } }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    background: Theme.surface2;
                    border-radius: 20px;
                    height: root.narrow ? 60px : 108px;
                    VerticalLayout {
                        padding: root.narrow ? 4px : 14px;
                        spacing: 10px;
                        alignment: center;
                        if !root.narrow: VerticalLayout {
                            Text { text: root.present ? root.device : "Móvil ausente"; color: Theme.text; font-weight: 600; overflow: elide; }
                            Text { text: root.present ? root.device-sub : "Sesión abierta con clave"; color: Theme.muted; font-size: 13px; overflow: elide; }
                        }
                        Pill {
                            label: root.narrow ? "B" : "Bloquear ahora";
                            min-width: root.narrow ? 40px : 96px;
                            clicked => { root.lock-now(); }
                        }
                    }
                }
            }
        }

        // Contenido
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg;
            VerticalLayout {
                padding-top: 22px;
                padding-right: 24px;
                padding-bottom: 14px;
                padding-left: 8px;
                spacing: 10px;

                if root.update-text != "": Rectangle {
                    height: 44px;
                    border-radius: 14px;
                    background: #12404a;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 12px;
                        Text { text: root.update-text; color: Theme.on-container; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        Pill { label: "Actualizar ahora"; height: 32px; y: 6px; clicked => { root.do-update(); } }
                    }
                }
                if root.warn != "": Rectangle {
                    height: 34px;
                    border-radius: 12px;
                    background: #4a3b00;
                    Text { x: 14px; text: root.warn; color: #ffe08a; vertical-alignment: center; overflow: elide; width: parent.width - 28px; }
                }

                // ------------------------------------------------------ Archivos
                if root.page == 0: VerticalLayout {
                    spacing: 12px;
                    Text { text: "Archivos"; font-size: 26px; color: Theme.text; }
                    HorizontalLayout {
                        spacing: 10px;
                        vertical-stretch: 1;
                        Pane {
                            title: "Este PC";
                            path: root.pc-path;
                            files: root.pc-files;
                            footer: root.pc-footer;
                            message: root.pc-message;
                            toggled(i) => { root.pane-toggle(false, i); }
                            opened(i) => { root.pane-open(false, i); }
                            up => { root.pane-up(false); }
                            refresh => { root.pane-refresh(false); }
                        }
                        VerticalLayout {
                            width: 110px;
                            alignment: center;
                            spacing: 10px;
                            Pill { label: "Enviar →"; min-width: 100px; clicked => { root.send-to-phone(); } }
                            Pill { label: "← Traer"; min-width: 100px; kind: 1; clicked => { root.bring-to-pc(); } }
                        }
                        Pane {
                            title: "Móvil";
                            path: root.phone-path;
                            files: root.phone-files;
                            footer: root.phone-footer;
                            message: root.phone-message;
                            toggled(i) => { root.pane-toggle(true, i); }
                            opened(i) => { root.pane-open(true, i); }
                            up => { root.pane-up(true); }
                            refresh => { root.pane-refresh(true); }
                        }
                    }
                    if root.transfer-active || root.transfer-text != "": Rectangle {
                        height: 44px;
                        background: Theme.surface;
                        border-radius: 14px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 10px;
                            spacing: 12px;
                            Text { text: root.transfer-text; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            if root.transfer-active: Rectangle {
                                width: 180px;
                                height: 6px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 3px;
                                background: Theme.surface3;
                                Rectangle { x: 0px; width: parent.width * root.transfer-frac; border-radius: 3px; background: Theme.primary; }
                            }
                            if root.transfer-active: Pill { label: "Cancelar"; kind: 2; height: 30px; min-width: 80px; y: 7px; clicked => { root.cancel-transfer(); } }
                        }
                    }
                }

                // ------------------------------------------------------ Notificaciones
                if root.page == 1: VerticalLayout {
                    spacing: 12px;
                    Text { text: "Notificaciones"; font-size: 26px; color: Theme.text; }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Pill { label: "Limpiar todas"; kind: 2; clicked => { root.clear-notifs(); } }
                        Text { text: root.notif-hint; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                    }
                    if root.notifs.length == 0: Text { text: "No hay notificaciones."; color: Theme.muted; }
                    ListView {
                        vertical-stretch: 1;
                        for n in root.notifs: Rectangle {
                            height: card.height + 8px;
                            card := NotifCard {
                                y: 0px;
                                x: 0px;
                                width: min(parent.width, 880px);
                                n: n;
                                status: root.call-status;
                                dismissed => { root.notif-dismiss(n.key); }
                                reply(t) => { root.notif-reply(n.key, n.reply-index, t); }
                                answer => { root.call-answer(n.key); }
                                end => { root.call-end(n.key); }
                                action(i) => { root.notif-action(n.key, i); }
                                copy-code(c) => { root.copy-code(c); }
                            }
                        }
                    }
                }

                // ------------------------------------------------------ Galería
                if root.page == 2: VerticalLayout {
                    spacing: 12px;
                    Text { text: "Galería"; font-size: 26px; color: Theme.text; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Pill { label: "Actualizar"; kind: 1; clicked => { root.gallery-refresh(); } }
                        Pill { label: root.gallery-selected > 0 ? "Traer " + root.gallery-selected + " al PC" : "Traer al PC"; enabled: root.gallery-selected > 0; clicked => { root.gallery-fetch(); } }
                        Pill { label: "Cargar más"; kind: 2; clicked => { root.gallery-more(); } }
                        Text { text: root.gallery-message; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.surface;
                        border-radius: 20px;
                        clip: true;
                        ScrollView {
                            viewport-height: Math.ceil(root.photos.length / root.cols) * root.cell + 20px;
                            for p[i] in root.photos: Rectangle {
                                x: Math.mod(i, root.cols) * root.cell + 12px;
                                y: Math.floor(i / root.cols) * root.cell + 12px;
                                width: root.cell - 8px;
                                height: root.cell - 8px;
                                border-radius: 12px;
                                background: Theme.surface2;
                                clip: true;
                                if p.has-thumb: Image { source: p.thumb; width: parent.width; height: parent.height; image-fit: cover; }
                                if p.video: Rectangle {
                                    x: 8px; y: parent.height - 30px; width: 26px; height: 22px; border-radius: 6px; background: #000000a0;
                                    Text { text: "▶"; color: white; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle { border-radius: 12px; border-width: p.selected ? 3px : 0px; border-color: Theme.primary; background: p.selected ? #4fd8eb30 : transparent; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.gallery-toggle(i); } }
                            }
                        }
                    }
                }

                // ------------------------------------------------------ Llamadas
                if root.page == 3: VerticalLayout {
                    spacing: 12px;
                    Text { text: "Llamadas"; font-size: 26px; color: Theme.text; }
                    HorizontalLayout {
                        spacing: 10px;
                        dial-box := LineEdit { placeholder-text: "Número para llamar"; accepted(t) => { root.dial(t); } }
                        Pill { label: "Llamar"; kind: 4; y: 2px; clicked => { root.dial(dial-box.text); } }
                    }
                    if root.calls-message != "": Text { text: root.calls-message; color: Theme.bad; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 14px;
                        vertical-stretch: 1;
                        Rectangle {
                            background: Theme.surface;
                            border-radius: 20px;
                            clip: true;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                Text { text: "Contactos"; font-size: 16px; color: Theme.text; }
                                LineEdit { placeholder-text: "Buscar"; edited(t) => { root.contacts-search(t); } }
                                ListView {
                                    vertical-stretch: 1;
                                    for c in root.contacts: Rectangle {
                                        height: 42px;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            Text { text: c.name; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                            Text { text: c.number; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                            Pill { label: "Llamar"; kind: 1; height: 30px; min-width: 70px; y: 6px; clicked => { root.dial(c.number); } }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            background: Theme.surface;
                            border-radius: 20px;
                            clip: true;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                Text { text: "Historial"; font-size: 16px; color: Theme.text; }
                                ListView {
                                    vertical-stretch: 1;
                                    for c in root.call-log: Rectangle {
                                        height: 46px;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            Text { text: c.kind == 1 ? "↙" : c.kind == 2 ? "↗" : "✕"; color: c.kind == 3 ? Theme.bad : Theme.ok; vertical-alignment: center; font-size: 16px; }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text { text: c.title; color: Theme.text; overflow: elide; }
                                                Text { text: c.detail; color: Theme.muted; font-size: 12px; overflow: elide; }
                                            }
                                            Pill { label: "Llamar"; kind: 1; height: 30px; min-width: 70px; y: 8px; clicked => { root.dial(c.number); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------------ Mensajes (SMS)
                if root.page == 7: VerticalLayout {
                    spacing: 12px;
                    Text { text: "Mensajes SMS"; font-size: 26px; color: Theme.text; }
                    if root.sms-message != "": Text { text: root.sms-message; color: Theme.bad; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 14px;
                        vertical-stretch: 1;
                        Rectangle {
                            width: 340px;
                            background: Theme.surface;
                            border-radius: 20px;
                            clip: true;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                HorizontalLayout {
                                    Text { text: "Conversaciones"; font-size: 16px; color: Theme.text; horizontal-stretch: 1; }
                                    Pill { label: "Actualizar"; kind: 1; height: 28px; min-width: 80px; clicked => { root.sms-refresh(); } }
                                }
                                ListView {
                                    vertical-stretch: 1;
                                    for t[i] in root.threads: Rectangle {
                                        height: 54px;
                                        border-radius: 12px;
                                        background: i == root.sms-selected ? Theme.container : ta.has-hover ? Theme.surface2 : transparent;
                                        VerticalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            alignment: center;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: t.title; color: Theme.text; font-weight: t.unread ? 700 : 400; overflow: elide; horizontal-stretch: 1; }
                                                Text { text: t.time; color: Theme.muted; font-size: 11px; }
                                            }
                                            Text { text: t.snippet; color: Theme.muted; font-size: 12px; overflow: elide; }
                                        }
                                        ta := TouchArea { mouse-cursor: pointer; clicked => { root.sms-open(i); } }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            background: Theme.surface;
                            border-radius: 20px;
                            clip: true;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                Text { text: root.sms-title == "" ? "Elige una conversación" : root.sms-title; font-size: 16px; color: Theme.text; overflow: elide; }
                                ListView {
                                    vertical-stretch: 1;
                                    for m in root.messages: Rectangle {
                                        height: bubble.height + 8px;
                                        bubble := Rectangle {
                                            x: m.mine ? parent.width - self.width - 6px : 6px;
                                            width: min(parent.width * 0.75, 420px);
                                            height: msg-text.preferred-height + 24px;
                                            border-radius: 14px;
                                            background: m.mine ? Theme.container : Theme.surface2;
                                            VerticalLayout {
                                                padding: 10px;
                                                spacing: 2px;
                                                msg-text := Text { text: m.text; color: m.mine ? Theme.on-container : Theme.text; wrap: word-wrap; }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    sms-box := LineEdit { placeholder-text: "Escribe un mensaje"; enabled: root.sms-title != ""; accepted(t) => { root.sms-send(t); self.text = ""; } }
                                    Pill { label: "Enviar"; kind: 4; y: 2px; enabled: root.sms-title != ""; clicked => { root.sms-send(sms-box.text); sms-box.text = ""; } }
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------------ Aplicaciones
                if root.page == 4: VerticalLayout {
                    spacing: 12px;
                    Text { text: "Aplicaciones del móvil"; font-size: 26px; color: Theme.text; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Pill { label: "Actualizar"; kind: 1; clicked => { root.apps-refresh(); } }
                        Pill { label: "Abrir en el PC"; enabled: root.app-selected >= 0 && root.advanced; clicked => { root.app-open-pc(); } }
                        Pill { label: "Detener"; kind: 2; enabled: root.app-selected >= 0 && root.advanced; clicked => { root.app-action("stop"); } }
                        Pill { label: "Ajustes de la app"; kind: 2; enabled: root.app-selected >= 0 && root.advanced; clicked => { root.app-action("settings"); } }
                        Pill { label: root.show-system ? "Ocultar de sistema" : "Mostrar de sistema"; kind: 2; clicked => { root.show-system = !root.show-system; root.apps-refresh(); } }
                    }
                    if !root.advanced: Text { text: "Abrir apps del móvil en el PC necesita el modo completo (actívalo en Móviles y ajustes)."; color: Theme.muted; wrap: word-wrap; }
                    if root.apps-message != "": Text { text: root.apps-message; color: Theme.muted; wrap: word-wrap; }
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.surface;
                        border-radius: 20px;
                        clip: true;
                        ListView {
                            for a[i] in root.apps: AppRow {
                                app: a;
                                selected: i == root.app-selected;
                                clicked => { root.app-select(i); }
                            }
                        }
                    }
                }

                // ------------------------------------------------------ Mensajería
                if root.page == 5: VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "Mensajería"; font-size: 26px; color: Theme.text; }
                    Text { text: "Cada servicio se abre en su propia ventana de Edge, aislada y con la sesión guardada, y se cierra al bloquear SyncroUmbral. Así no hay un navegador residente dentro de la aplicación."; color: Theme.muted; wrap: word-wrap; }
                    for s[i] in root.services: Card {
                        HorizontalLayout {
                            spacing: 12px;
                            height: 44px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text { text: s.name; color: Theme.text; font-size: 15px; }
                                Text { text: s.has-session ? "Sesión guardada" : "Sin iniciar sesión"; color: Theme.muted; font-size: 12px; }
                            }
                            if s.has-session: Pill { label: "Olvidar sesión"; kind: 3; y: 4px; clicked => { root.web-forget(i); } }
                            Pill { label: "Abrir"; y: 4px; clicked => { root.web-open(i); } }
                        }
                    }
                }

                // ------------------------------------------------------ Móviles y ajustes
                if root.page == 6: ScrollView {
                    VerticalLayout {
                        spacing: 14px;
                        alignment: start;
                        padding-right: 8px;
                        Text { text: "Móviles y ajustes"; font-size: 26px; color: Theme.text; }
                        Card {
                            title: "Móviles vinculados";
                            if root.devices.length == 0: Text { text: "Aún no hay ningún móvil vinculado."; color: Theme.muted; }
                            for d in root.devices: HorizontalLayout {
                                spacing: 12px;
                                height: 38px;
                                Text { text: d.name; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Pill { label: "Quitar"; kind: 3; height: 30px; min-width: 70px; y: 4px; clicked => { root.remove-device(d.id); } }
                            }
                            HorizontalLayout {
                                spacing: 18px;
                                Rectangle {
                                    width: 210px;
                                    height: 210px;
                                    border-radius: 12px;
                                    background: root.qr.width > 0 ? white : Theme.surface2;
                                    if root.qr.width > 0: Image { source: root.qr; width: parent.width - 12px; height: parent.height - 12px; x: 6px; y: 6px; image-rendering: pixelated; }
                                }
                                VerticalLayout {
                                    spacing: 10px;
                                    alignment: center;
                                    Text { text: "Para vincular un móvil, abre SyncroUmbral en el móvil y escanea este código. Vale 5 minutos."; color: Theme.muted; wrap: word-wrap; }
                                    Text { text: root.qr-text; color: Theme.text; wrap: word-wrap; }
                                    HorizontalLayout { alignment: start; Pill { label: "Generar código"; clicked => { root.make-qr(); } } }
                                }
                            }
                        }
                        Card {
                            title: "Funcionamiento";
                            SwitchRow { label: "Iniciar con Windows (en segundo plano)"; checked <=> root.autostart; toggled(v) => { root.toggled-autostart(v); } }
                            SwitchRow { label: "Silenciar el resto de sonidos del PC mientras suena una llamada"; hint: "No toca mejoradores de audio como FxSound o Voicemeeter."; checked <=> root.mute-on-call; toggled(v) => { root.toggled-mute(v); } }
                            SwitchRow { label: "Modo completo"; hint: "Permite abrir apps del móvil en el PC (necesita adb y scrcpy)."; checked <=> root.advanced; toggled(v) => { root.toggled-advanced(v); } }
                        }
                        Card {
                            title: "Seguridad y avisos";
                            SwitchRow { label: "Bloquear Windows al alejarte con el móvil"; hint: "Pasados 15 s sin el móvil se bloquea la sesión de Windows. Se abre con tu clave de Windows."; checked <=> root.lock-windows; toggled(v) => { root.toggled-lock-windows(v); } }
                            SwitchRow { label: "Ocultar el contenido de los avisos"; hint: "Los avisos emergentes muestran solo la app. Útil al compartir pantalla."; checked <=> root.hide-content; toggled(v) => { root.toggled-hide(v); } }
                            Text { text: "Silenciar avisos emergentes que contengan estas palabras (separadas por comas)"; color: Theme.text; wrap: word-wrap; }
                            LineEdit { text <=> root.mute-words; placeholder-text: "oferta, promoción, sorteo"; edited(t) => { root.mute-words-edited(t); } }
                        }
                        Card {
                            title: "Copias y envío rápido";
                            SwitchRow { label: "Copia automática de las fotos nuevas al PC"; hint: "Solo las que hagas desde que lo actives. Se guardan en Imágenes\\SyncroUmbral\\Copia."; checked <=> root.photo-backup; toggled(v) => { root.toggled-backup(v); } }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Pill { label: "Añadir «Enviar al móvil» al Explorador"; kind: 1; clicked => { root.context-menu(true); } }
                                Pill { label: "Quitarlo"; kind: 2; clicked => { root.context-menu(false); } }
                            }
                        }
                        Card {
                            title: "Acciones del móvil";
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Pill { label: root.ringing ? "Parar de sonar" : "Hacer sonar el móvil"; kind: root.ringing ? 5 : 1; clicked => { root.ring-phone(!root.ringing); } }
                                Pill { label: "Enviar portapapeles al móvil"; kind: 1; clicked => { root.send-clipboard(); } }
                            }
                            Text { text: "El móvil suena al máximo aunque esté en silencio, hasta 1 minuto. Para enviar el portapapeles del móvil al PC usa el botón de la notificación permanente."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        }
                        Card {
                            title: "Herramientas";
                            Text { text: root.tools-text; color: Theme.muted; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Pill { label: "Instalar adb"; kind: 1; clicked => { root.install-tool("adb"); } }
                                Pill { label: "Instalar scrcpy"; kind: 1; clicked => { root.install-tool("scrcpy"); } }
                            }
                        }
                    }
                }

                // Mensaje de estado (barra inferior)
                if root.status != "": Rectangle {
                    height: 32px;
                    border-radius: 16px;
                    background: Theme.surface3;
                    Text { x: 16px; text: root.status; color: Theme.text; vertical-alignment: center; overflow: elide; width: parent.width - 32px; }
                }
            }
        }
    }
}
