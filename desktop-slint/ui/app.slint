// SyncroUmbral: interfaz nativa (sin WebView). Misma paleta y estructura que la versión HTML.
import { LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon, FileItem, Notif, NotifAction, ThreadItem, MsgItem, Photo, AlbumItem, ContactItem, CallItem, AppItem, DeviceItem, ServiceItem, Pill, Toggle, SwitchRow, NavItem, Pane } from "common.slint";
import { NotifCard, NotifSize } from "notif.slint";
import { ToastWindow } from "toast.slint";

export { Theme, FileItem, Notif, NotifAction, ThreadItem, MsgItem, Photo, AlbumItem, ContactItem, CallItem, AppItem, DeviceItem, ServiceItem, ToastWindow }

// Tarjeta con título y explicación.
component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    background: Theme.surface;
    border-radius: 20px;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 22px;
        spacing: 10px;
        if root.title != "": Text { text: root.title; font-size: 16px; font-weight: 600; color: Theme.text; }
        if root.subtitle != "": Text { text: root.subtitle; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
        @children
    }
}

// Mosaico de una app del móvil: icono y nombre.
component AppTile inherits Rectangle {
    in property <AppItem> app;
    in property <bool> selected;
    callback clicked();
    border-radius: 16px;
    background: selected ? Theme.container : t.has-hover ? Theme.surface2 : transparent;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        alignment: center;
        Rectangle {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: Theme.surface3;
            clip: true;
            if app.has-icon: Image { source: app.icon; width: parent.width; height: parent.height; image-fit: contain; }
            if !app.has-icon: Text { text: "?"; color: Theme.muted; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { text: app.label; color: selected ? Theme.on-container : Theme.text; font-size: 12px; horizontal-alignment: center; overflow: elide; }
    }
    if app.open: Rectangle { x: parent.width - 20px; y: 8px; width: 10px; height: 10px; border-radius: 5px; background: Theme.ok; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Fila de acción rápida del panel derecho.
component QuickAction inherits Rectangle {
    in property <string> icon-d;
    in property <string> title;
    in property <string> hint;
    in property <bool> active;
    callback clicked();
    height: 62px;
    border-radius: 14px;
    background: touch.has-hover ? Theme.surface2 : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        Rectangle {
            width: 36px;
            height: 36px;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: root.active ? Theme.bad : Theme.container;
            Icon { d: root.icon-d; tint: root.active ? #410002 : Theme.on-container; x: 8px; y: 8px; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.title; color: Theme.text; font-weight: 500; overflow: elide; }
            Text { text: root.hint; color: Theme.muted; font-size: 11px; overflow: elide; }
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    title: "SyncroUmbral";
    icon: @image-url("icon.png");
    background: Theme.bg;
    min-width: 860px;
    min-height: 560px;
    preferred-width: 1180px;
    preferred-height: 760px;
    default-font-family: "Inter";
    default-font-size: 14px;

    // ---- estado general
    in-out property <bool> locked: true;
    in-out property <int> page: 0;
    in-out property <bool> side-collapsed: false;
    in property <bool> present: false;
    in property <bool> has-password: false;
    in property <string> device;
    in property <string> device-sub;
    in property <int> battery: -1;
    in property <bool> charging;
    in property <string> lock-error;
    in property <string> lock-hint;
    in property <string> status;
    in property <string> warn;

    // ---- archivos
    in property <[FileItem]> pc-files;
    in property <[FileItem]> phone-files;
    in property <string> pc-path;
    in property <string> phone-path;
    in property <string> pc-footer;
    in property <string> pc-message;
    in property <string> phone-message;
    in property <string> phone-footer;
    in-out property <string> pc-filter;
    in-out property <string> phone-filter;
    in property <string> transfer-text;
    in property <float> transfer-frac;
    in property <bool> transfer-active;
    in-out property <bool> pc-grid: false;
    in-out property <bool> phone-grid: false;
    /// Verdadero mientras se arrastra un archivo del Explorador sobre la ventana.
    in property <bool> dragging: false;

    // ---- notificaciones
    in property <[Notif]> notifs;
    in property <string> notif-hint;
    in property <string> call-status;

    // ---- galería
    in property <[Photo]> photos;
    in property <[AlbumItem]> albums;
    in property <int> album-selected: -1;
    in property <string> gallery-message;
    in property <int> gallery-selected;

    // ---- mensajes SMS
    in property <[ThreadItem]> threads;
    in property <[MsgItem]> messages;
    in property <string> sms-message;
    in property <string> sms-title;
    in property <int> sms-selected: -1;

    // ---- llamadas
    in property <[ContactItem]> contacts;
    in property <[CallItem]> call-log;
    in property <string> calls-message;

    // ---- aplicaciones
    in property <[AppItem]> apps;
    in property <string> apps-message;
    in property <int> app-selected: -1;
    in-out property <bool> show-system: false;

    // ---- mensajería
    in property <[ServiceItem]> services;

    // ---- ajustes
    in property <[DeviceItem]> devices;
    in property <image> qr;
    in property <string> qr-text;
    in-out property <bool> autostart: true;
    in property <string> autostart-status;
    in property <string> disk-text;
    in property <string> old-data-text;
    in property <bool> old-data-exists;
    in-out property <bool> old-data-confirm: false;
    callback delete-old-data();
    in property <bool> autostart-problem;
    callback open-startup-settings();
    in-out property <bool> mute-on-call: true;
    in-out property <bool> advanced: false;
    in property <string> tools-text;
    in property <bool> ringing;
    in-out property <bool> lock-windows: false;
    in-out property <bool> hide-content: false;
    in-out property <string> mute-words;
    in-out property <bool> photo-backup: false;
    in property <string> update-text;
    in property <string> app-version;
    in-out property <string> updated-text;
    in-out property <string> whats-new;
    callback show-whats-new();

    callback unlock(string);
    callback lock-now();
    callback pane-toggle(bool, int);
    callback pane-open(bool, int);
    callback pane-up(bool);
    callback pane-refresh(bool);
    callback pane-filter(bool, string);
    callback pane-select-all(bool);
    callback send-to-phone();
    callback bring-to-pc();
    callback cancel-transfer();
    callback notif-dismiss(string);
    callback notif-reply(string, int, string);
    callback call-answer(string);
    callback call-end(string);
    callback notif-action(string, int);
    callback clear-notifs();
    callback apps-refresh();
    callback apps-search(string);
    callback app-select(int);
    callback app-open-pc();
    callback app-action(string);
    callback web-open(int);
    callback web-forget(int);
    callback add-service(string, string);
    callback remove-service(int);
    callback make-qr();
    callback copy-pairing();
    callback remove-device(string);
    callback toggled-autostart(bool);
    callback toggled-mute(bool);
    callback toggled-advanced(bool);
    callback install-tool(string);
    callback page-changed(int);
    callback copy-code(string);
    callback gallery-refresh();
    callback gallery-more();
    callback gallery-toggle(int);
    callback gallery-fetch();
    callback gallery-album(int);
    callback dial(string);
    callback contacts-search(string);
    callback ring-phone(bool);
    callback send-clipboard();
    callback sms-refresh();
    callback sms-open(int);
    callback sms-send(string);
    callback toggled-lock-windows(bool);
    callback toggled-hide(bool);
    callback mute-words-edited(string);
    callback toggled-backup(bool);
    callback context-menu(bool);
    callback do-update();
    callback check-updates();
    callback open-link(string);

    // ---- medidas derivadas: el contenido se adapta al ancho (y en pantalla grande aparece el panel derecho)
    property <bool> narrow: root.side-collapsed || root.width < 1000px;
    property <bool> rail: root.width >= 1480px;
    property <length> side-w: root.narrow ? 76px : 248px;
    property <length> content-w: root.width - root.side-w - (root.rail ? 330px : 0px) - 40px;
    property <bool> wide: root.content-w >= 980px;
    property <length> gcell-w: (root.content-w - 40px) / Math.max(1, Math.floor((root.content-w - 40px) / 150px));
    property <int> gcols: Math.max(1, Math.floor((root.content-w - 40px) / 150px));
    property <int> acols: Math.max(1, Math.floor((root.content-w - 40px) / 138px));
    property <length> acell-w: (root.content-w - 40px) / Math.max(1, Math.floor((root.content-w - 40px) / 138px));

    property <int> ncols: Math.max(1, Math.floor(root.content-w / 430px));
    property <int> scols: Math.max(1, Math.floor(root.content-w / 440px));
    property <length> scell-w: root.content-w / Math.max(1, Math.floor(root.content-w / 440px));
    property <string> page-title: root.page == 0 ? "Archivos" : root.page == 1 ? "Notificaciones" : root.page == 2 ? "Galería" : root.page == 3 ? "Llamadas"
        : root.page == 4 ? "Aplicaciones del móvil" : root.page == 5 ? "Mensajería" : root.page == 7 ? "Mensajes SMS" : "Móviles y ajustes";
    property <string> page-sub: root.page == 0 ? "Copia archivos entre el PC y el móvil. También puedes arrastrarlos sobre esta ventana."
        : root.page == 1 ? "Lo que llega al móvil, en tiempo real. Responde, cuelga llamadas o copia códigos de verificación."
        : root.page == 2 ? "Fotos y vídeos del móvil por álbum. Marca los que quieras y tráelos al PC."
        : root.page == 3 ? "Marca un número, llama a un contacto o devuelve una llamada. El audio sigue en el móvil."
        : root.page == 4 ? "Abre cualquier app del móvil en una ventana del PC. Necesita el modo completo."
        : root.page == 5 ? "WhatsApp, Telegram y más en su propia ventana, con la sesión guardada."
        : root.page == 7 ? "Lee y envía SMS desde el PC. No incluye MMS ni RCS."
        : "Vincula móviles y decide cómo se comporta SyncroUmbral.";

    // ---------------------------------------------------------------- bloqueo
    if root.locked: Rectangle {
        background: @radial-gradient(circle, #1c3a3f 0%, Theme.bg 70%);
        Rectangle {
            width: 440px;
            height: 330px;
            background: #171d1ecc;
            border-radius: 24px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 30px;
                spacing: 12px;
                alignment: center;
                HorizontalLayout { alignment: center; Image { source: @image-url("icon.png"); width: 52px; height: 52px; } }
                Text { text: root.has-password ? "SyncroUmbral bloqueado" : "Crea una clave"; font-size: 22px; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                Text {
                    text: root.has-password ? root.lock-hint : "Sirve para abrir SyncroUmbral cuando no tengas el móvil cerca (mínimo 8 caracteres).";
                    color: Theme.muted;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                pw := LineEdit {
                    placeholder-text: root.has-password ? "O escribe tu clave" : "Elige una clave";
                    input-type: password;
                    accepted(t) => { root.unlock(t); }
                }
                Pill { icon-d: Icons.lock; label: root.has-password ? "Desbloquear" : "Crear clave"; clicked => { root.unlock(pw.text); pw.text = ""; } }
                Text { text: root.lock-error; color: Theme.bad; horizontal-alignment: center; wrap: word-wrap; }
            }
        }
    }

    // ---------------------------------------------------------------- principal
    if !root.locked: HorizontalLayout {
        // ------------------------------------------------------------ menú lateral
        Rectangle {
            width: root.side-w;
            animate width { duration: 150ms; easing: ease-out; }
            VerticalLayout {
                padding: 14px;
                padding-top: 22px;
                spacing: 4px;
                HorizontalLayout {
                    padding-bottom: 20px;
                    padding-left: root.narrow ? 0px : 8px;
                    spacing: 10px;
                    alignment: root.narrow ? center : start;
                    Image { source: @image-url("icon.png"); width: 34px; height: 34px; }
                    if !root.narrow: Text {
                        text: "SyncroUmbral";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if root.width >= 1000px: Rectangle {
                        width: 34px;
                        height: 34px;
                        y: 0px;
                        border-radius: 17px;
                        background: tg.has-hover ? Theme.surface : transparent;
                        Icon { d: root.side-collapsed ? Icons.right : Icons.left; x: 7px; y: 7px; }
                        tg := TouchArea { mouse-cursor: pointer; clicked => { root.side-collapsed = !root.side-collapsed; } }
                    }
                }
                NavItem { label: "Archivos"; icon-d: Icons.folder; active: root.page == 0; collapsed: root.narrow; clicked => { root.page = 0; root.page-changed(0); } }
                NavItem { label: "Notificaciones"; icon-d: Icons.bell; active: root.page == 1; badge: root.notifs.length; collapsed: root.narrow; clicked => { root.page = 1; root.page-changed(1); } }
                NavItem { label: "Galería"; icon-d: Icons.image; active: root.page == 2; collapsed: root.narrow; clicked => { root.page = 2; root.page-changed(2); } }
                NavItem { label: "Llamadas"; icon-d: Icons.call; active: root.page == 3; collapsed: root.narrow; clicked => { root.page = 3; root.page-changed(3); } }
                NavItem { label: "Mensajes"; icon-d: Icons.chat; active: root.page == 7; collapsed: root.narrow; clicked => { root.page = 7; root.page-changed(7); } }
                NavItem { label: "Aplicaciones"; icon-d: Icons.apps; active: root.page == 4; collapsed: root.narrow; clicked => { root.page = 4; root.page-changed(4); } }
                NavItem { label: "Mensajería"; icon-d: Icons.forum; active: root.page == 5; collapsed: root.narrow; clicked => { root.page = 5; root.page-changed(5); } }
                NavItem { label: "Móviles y ajustes"; icon-d: Icons.settings; active: root.page == 6; collapsed: root.narrow; clicked => { root.page = 6; root.page-changed(6); } }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    background: Theme.surface;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: Theme.border;
                    height: root.narrow ? 96px : 116px;
                    VerticalLayout {
                        padding: root.narrow ? 8px : 14px;
                        spacing: 10px;
                        alignment: center;
                        if root.narrow: Icon { d: Icons.phone-android; tint: root.present ? Theme.ok : Theme.muted; width: 22px; height: 22px; x: (parent.width - 16px - self.width) / 2; }
                        if !root.narrow: VerticalLayout {
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle { width: 8px; height: 8px; y: 6px; border-radius: 4px; background: root.present ? Theme.ok : Theme.muted; }
                                Text { text: root.present ? root.device : "Móvil ausente"; color: Theme.text; font-weight: 600; overflow: elide; }
                            }
                            Text { text: root.present ? root.device-sub : "Sesión abierta con clave"; color: Theme.muted; font-size: 12px; overflow: elide; }
                        }
                        Pill { icon-d: Icons.lock; label: root.narrow ? "" : "Bloquear ahora"; clicked => { root.lock-now(); } }
                    }
                }
            }
        }

        // ------------------------------------------------------------ contenido
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg;
            VerticalLayout {
                padding-top: 24px;
                padding-right: 20px;
                padding-bottom: 14px;
                padding-left: 8px;
                spacing: 12px;

                // Cabecera: título, explicación y acciones rápidas siempre visibles
                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: root.page-title; font-size: 26px; font-weight: 600; color: Theme.text; overflow: elide; }
                        Text { text: root.page-sub; font-size: 13px; color: Theme.muted; overflow: elide; }
                    }
                    if !root.rail: HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Pill { icon-d: Icons.clipboard; label: root.width >= 1250px ? "Portapapeles al móvil" : ""; kind: 1; y: 6px; clicked => { root.send-clipboard(); } }
                        Pill { icon-d: Icons.sound; label: root.width >= 1250px ? (root.ringing ? "Parar" : "Hacer sonar") : ""; kind: root.ringing ? 5 : 1; y: 6px; clicked => { root.ring-phone(!root.ringing); } }
                    }
                }

                // Aviso tras actualizar: qué versión quedó y enlace a sus novedades.
                if root.updated-text != "": Rectangle {
                    height: 44px;
                    border-radius: 14px;
                    background: #12404a;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 12px;
                        Icon { d: Icons.check; tint: Theme.ok; width: 20px; height: 20px; y: 12px; }
                        Text { text: root.updated-text; color: Theme.on-container; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        Pill { icon-d: Icons.open-in-new; label: "Ver novedades"; height: 32px; y: 6px; clicked => { root.show-whats-new(); } }
                        Pill { icon-d: Icons.close; label: ""; kind: 1; height: 32px; y: 6px; clicked => { root.updated-text = ""; } }
                    }
                }

                if root.update-text != "": Rectangle {
                    height: 44px;
                    border-radius: 14px;
                    background: #12404a;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 12px;
                        Text { text: root.update-text; color: Theme.on-container; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        Pill { icon-d: Icons.download; label: "Actualizar ahora"; height: 32px; y: 6px; clicked => { root.do-update(); } }
                    }
                }
                if root.warn != "": Rectangle {
                    height: 36px;
                    border-radius: 12px;
                    background: #4a3b00;
                    Text { x: 14px; text: root.warn; color: #ffe08a; vertical-alignment: center; overflow: elide; width: parent.width - 28px; }
                }

                // ------------------------------------------------------ Archivos
                if root.page == 0: VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 10px;
                        vertical-stretch: 1;
                        Pane {
                            title: "Este PC";
                            grid <=> root.pc-grid;
                            path: root.pc-path;
                            files: root.pc-files;
                            footer: root.pc-footer;
                            message: root.pc-message;
                            toggled(i) => { root.pane-toggle(false, i); }
                            opened(i) => { root.pane-open(false, i); }
                            up => { root.pane-up(false); }
                            refresh => { root.pane-refresh(false); }
                            filter-text <=> root.pc-filter;
                            filter(t) => { root.pane-filter(false, t); }
                            select-all => { root.pane-select-all(false); }
                        }
                        VerticalLayout {
                            width: 150px;
                            alignment: center;
                            spacing: 6px;
                            Pill { icon-d: Icons.send; label: "Enviar al móvil"; min-width: 140px; clicked => { root.send-to-phone(); } }
                            Text { text: "a: " + (root.phone-path == "" ? "raíz" : root.phone-path); color: Theme.muted; font-size: 11px; wrap: word-wrap; horizontal-alignment: center; }
                            Rectangle { height: 14px; }
                            Pill { icon-d: Icons.download; label: "Traer al PC"; min-width: 140px; kind: 1; clicked => { root.bring-to-pc(); } }
                            Text { text: "a: " + root.pc-path; color: Theme.muted; font-size: 11px; wrap: word-wrap; horizontal-alignment: center; }
                            Text { text: "Entra en una carpeta con un clic y marca con la casilla lo que quieras mover."; color: Theme.muted; font-size: 11px; wrap: word-wrap; horizontal-alignment: center; }
                        }
                        Pane {
                            title: "Móvil";
                            grid <=> root.phone-grid;
                            path: root.phone-path;
                            files: root.phone-files;
                            footer: root.phone-footer;
                            message: root.phone-message;
                            toggled(i) => { root.pane-toggle(true, i); }
                            opened(i) => { root.pane-open(true, i); }
                            up => { root.pane-up(true); }
                            refresh => { root.pane-refresh(true); }
                            filter-text <=> root.phone-filter;
                            filter(t) => { root.pane-filter(true, t); }
                            select-all => { root.pane-select-all(true); }
                        }
                    }
                    if root.transfer-active || root.transfer-text != "": Rectangle {
                        height: 46px;
                        background: Theme.surface;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.border;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 10px;
                            spacing: 12px;
                            Text { text: root.transfer-text; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            if root.transfer-active: Rectangle {
                                width: 220px;
                                height: 6px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 3px;
                                background: Theme.surface3;
                                Rectangle { x: 0px; width: parent.width * root.transfer-frac; border-radius: 3px; background: Theme.primary; }
                            }
                            if root.transfer-active: Pill { label: "Cancelar"; kind: 2; height: 30px; min-width: 80px; y: 8px; clicked => { root.cancel-transfer(); } }
                        }
                    }
                }

                // ------------------------------------------------------ Notificaciones
                if root.page == 1: VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Pill { icon-d: Icons.close; label: "Limpiar todas"; kind: 2; clicked => { root.clear-notifs(); } }
                        Text { text: root.notif-hint; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                    }
                    if root.notifs.length == 0: Text { text: "No hay notificaciones."; color: Theme.muted; }
                    // Las tarjetas se reparten en columnas (de izquierda a derecha) para aprovechar el ancho de la ventana.
                    ScrollView {
                        vertical-stretch: 1;
                        HorizontalLayout {
                            spacing: 10px;
                            padding-right: 4px;
                            for c in root.ncols: VerticalLayout {
                                alignment: start;
                                for n[i] in root.notifs: Rectangle {
                                    property <bool> mine: Math.mod(i, root.ncols) == c;
                                    property <length> hh: self.mine ? NotifSize.of(n) + 8px : 0px;
                                    height: self.hh;
                                    if self.mine: NotifCard {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width - 8px;
                                        n: n;
                                        status: root.call-status;
                                        dismissed => { root.notif-dismiss(n.key); }
                                        reply(t) => { root.notif-reply(n.key, n.reply-index, t); }
                                        answer => { root.call-answer(n.key); }
                                        end => { root.call-end(n.key); }
                                        action(ai) => { root.notif-action(n.key, ai); }
                                        copy-code(code) => { root.copy-code(code); }
                                    }
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------------ Galería
                if root.page == 2: VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Pill { icon-d: Icons.refresh; label: "Actualizar"; kind: 1; clicked => { root.gallery-refresh(); } }
                        Pill { icon-d: Icons.download; label: root.gallery-selected > 0 ? "Traer " + root.gallery-selected + " al PC" : "Traer al PC"; enabled: root.gallery-selected > 0; clicked => { root.gallery-fetch(); } }
                        Pill { label: "Cargar más"; kind: 2; clicked => { root.gallery-more(); } }
                        Text { text: root.gallery-message; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                    }
                    // Álbumes: todas las carpetas con fotos o vídeos. Fondo opaco y por encima de la rejilla: al hacer scroll las fotos nunca pasan sobre los botones.
                    Rectangle {
                        height: 44px;
                        z: 5;
                        background: Theme.bg;
                        ScrollView {
                            height: 44px;
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    height: 34px;
                                    width: all-label.preferred-width + 28px;
                                    border-radius: 17px;
                                    background: root.album-selected < 0 ? Theme.container : Theme.surface;
                                    border-width: 1px;
                                    border-color: root.album-selected < 0 ? Theme.container : Theme.border;
                                    all-label := Text { text: "Todo"; color: root.album-selected < 0 ? Theme.on-container : Theme.text; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.gallery-album(-1); } }
                                }
                                for al[i] in root.albums: Rectangle {
                                    height: 34px;
                                    width: al-label.preferred-width + 28px;
                                    border-radius: 17px;
                                    background: i == root.album-selected ? Theme.container : Theme.surface;
                                    border-width: 1px;
                                    border-color: i == root.album-selected ? Theme.container : Theme.border;
                                    al-label := Text { text: al.name + "  " + al.count; color: i == root.album-selected ? Theme.on-container : Theme.text; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.gallery-album(i); } }
                                }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.surface;
                        border-radius: 20px;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;
                        ScrollView {
                            content-height: Math.ceil(root.photos.length / root.gcols) * root.gcell-w + 24px;
                            for p[i] in root.photos: Rectangle {
                                x: Math.mod(i, root.gcols) * root.gcell-w + 14px;
                                y: Math.floor(i / root.gcols) * root.gcell-w + 12px;
                                width: root.gcell-w - 8px;
                                height: root.gcell-w - 8px;
                                border-radius: 12px;
                                background: Theme.surface2;
                                clip: true;
                                if p.has-thumb: Image { source: p.thumb; width: parent.width; height: parent.height; image-fit: cover; }
                                if p.video: Rectangle {
                                    x: 8px; y: parent.height - 30px; width: 26px; height: 22px; border-radius: 6px; background: #000000a0;
                                    Text { text: "▶"; color: white; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle { border-radius: 12px; border-width: p.selected ? 3px : 0px; border-color: Theme.primary; background: p.selected ? #4fd8eb30 : transparent; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.gallery-toggle(i); } }
                            }
                        }
                    }
                }

                // ------------------------------------------------------ Llamadas
                if root.page == 3: VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 10px;
                        dial-box := LineEdit { placeholder-text: "Número para llamar"; accepted(t) => { root.dial(t); } }
                        Pill { icon-d: Icons.call; label: "Llamar"; kind: 4; y: 2px; clicked => { root.dial(dial-box.text); } }
                    }
                    if root.calls-message != "": Text { text: root.calls-message; color: Theme.bad; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 14px;
                        vertical-stretch: 1;
                        Rectangle {
                            background: Theme.surface;
                            border-radius: 20px;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;
                                Text { text: "Contactos"; font-size: 16px; font-weight: 600; color: Theme.text; }
                                LineEdit { placeholder-text: "Buscar por nombre o número"; edited(t) => { root.contacts-search(t); } }
                                ListView {
                                    vertical-stretch: 1;
                                    for c in root.contacts: Rectangle {
                                        height: 44px;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            padding-right: 22px;
                                            Text { text: c.name; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                            Text { text: c.number; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                            Pill { icon-d: Icons.call; label: ""; kind: 1; height: 32px; y: 6px; clicked => { root.dial(c.number); } }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            background: Theme.surface;
                            border-radius: 20px;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;
                                Text { text: "Historial"; font-size: 16px; font-weight: 600; color: Theme.text; }
                                ListView {
                                    vertical-stretch: 1;
                                    for c in root.call-log: Rectangle {
                                        height: 50px;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            padding-right: 22px;
                                            Text { text: c.kind == 1 ? "↙" : c.kind == 2 ? "↗" : "✕"; color: c.kind == 3 ? Theme.bad : Theme.ok; vertical-alignment: center; font-size: 16px; }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text { text: c.title; color: Theme.text; overflow: elide; }
                                                Text { text: c.detail; color: Theme.muted; font-size: 12px; overflow: elide; }
                                            }
                                            Pill { icon-d: Icons.call; label: ""; kind: 1; height: 32px; y: 9px; clicked => { root.dial(c.number); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------------ Mensajes (SMS)
                if root.page == 7: VerticalLayout {
                    spacing: 12px;
                    if root.sms-message != "": Text { text: root.sms-message; color: Theme.bad; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 14px;
                        vertical-stretch: 1;
                        Rectangle {
                            width: Math.max(320px, Math.min(480px, root.content-w * 0.3));
                            background: Theme.surface;
                            border-radius: 20px;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;
                                HorizontalLayout {
                                    Text { text: "Conversaciones"; font-size: 16px; font-weight: 600; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
                                    Pill { icon-d: Icons.refresh; label: ""; kind: 1; height: 32px; clicked => { root.sms-refresh(); } }
                                }
                                ListView {
                                    vertical-stretch: 1;
                                    for t[i] in root.threads: Rectangle {
                                        height: 58px;
                                        border-radius: 12px;
                                        background: i == root.sms-selected ? Theme.container : ta.has-hover ? Theme.surface2 : transparent;
                                        VerticalLayout {
                                            padding-left: 12px;
                                            padding-right: 24px;
                                            alignment: center;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: t.title; color: i == root.sms-selected ? Theme.on-container : Theme.text; font-weight: t.unread ? 600 : 400; overflow: elide; horizontal-stretch: 1; }
                                                Text { text: t.time; color: Theme.muted; font-size: 11px; }
                                            }
                                            Text { text: t.snippet; color: i == root.sms-selected ? Theme.on-container : Theme.muted; font-size: 12px; overflow: elide; }
                                        }
                                        ta := TouchArea { mouse-cursor: pointer; clicked => { root.sms-open(i); } }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            background: Theme.surface;
                            border-radius: 20px;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;
                                Text { text: root.sms-title == "" ? "Elige una conversación" : root.sms-title; font-size: 16px; font-weight: 600; color: Theme.text; overflow: elide; }
                                ListView {
                                    vertical-stretch: 1;
                                    for m in root.messages: Rectangle {
                                        height: bubble.height + 8px;
                                        bubble := Rectangle {
                                            x: m.mine ? parent.width - self.width - 22px : 4px;
                                            width: min((parent.width - 22px) * 0.7, 560px);
                                            height: msg-text.preferred-height + 22px;
                                            border-radius: 16px;
                                            background: m.mine ? Theme.container : Theme.surface2;
                                            VerticalLayout {
                                                padding: 11px;
                                                msg-text := Text { text: m.text; color: m.mine ? Theme.on-container : Theme.text; wrap: word-wrap; }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    sms-box := LineEdit { placeholder-text: "Escribe un mensaje"; enabled: root.sms-title != ""; accepted(t) => { root.sms-send(t); self.text = ""; } }
                                    Pill { icon-d: Icons.send; label: "Enviar"; kind: 4; y: 2px; enabled: root.sms-title != ""; clicked => { root.sms-send(sms-box.text); sms-box.text = ""; } }
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------------ Aplicaciones
                if root.page == 4: VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        LineEdit { placeholder-text: "Buscar app"; width: 220px; edited(t) => { root.apps-search(t); } }
                        Pill { icon-d: Icons.refresh; label: "Actualizar"; kind: 1; clicked => { root.apps-refresh(); } }
                        Pill { icon-d: Icons.phone-android; label: "Abrir en el PC"; enabled: root.app-selected >= 0 && root.advanced; clicked => { root.app-open-pc(); } }
                        Pill { label: "Detener"; kind: 2; enabled: root.app-selected >= 0 && root.advanced; clicked => { root.app-action("stop"); } }
                        Pill { label: "Ajustes de la app"; kind: 2; enabled: root.app-selected >= 0 && root.advanced; clicked => { root.app-action("settings"); } }
                        Pill { label: root.show-system ? "Ocultar de sistema" : "Mostrar de sistema"; kind: 2; clicked => { root.show-system = !root.show-system; root.apps-refresh(); } }
                    }
                    if !root.advanced: Text { text: "Abrir apps del móvil en el PC necesita el modo completo: actívalo en Móviles y ajustes."; color: Theme.muted; wrap: word-wrap; }
                    if root.apps-message != "": Text { text: root.apps-message; color: Theme.muted; wrap: word-wrap; }
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.surface;
                        border-radius: 20px;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;
                        ScrollView {
                            content-height: Math.ceil(root.apps.length / root.acols) * 112px + 24px;
                            for a[i] in root.apps: AppTile {
                                x: Math.mod(i, root.acols) * root.acell-w + 14px;
                                y: Math.floor(i / root.acols) * 112px + 12px;
                                width: root.acell-w - 8px;
                                height: 104px;
                                app: a;
                                selected: i == root.app-selected;
                                clicked => { root.app-select(i); }
                            }
                        }
                    }
                }

                // ------------------------------------------------------ Mensajería
                if root.page == 5: VerticalLayout {
                    spacing: 12px;
                    vertical-stretch: 1;
                    Card {
                        title: "Añadir un servicio";
                        subtitle: "Cualquier web de mensajes o correo que funcione en el navegador: ponle un nombre y pega su dirección (https). Se abre en su propia ventana, aislada, con la sesión guardada.";
                        HorizontalLayout {
                            spacing: 10px;
                            svc-name := LineEdit { placeholder-text: "Nombre (por ejemplo, Signal)"; width: 240px; }
                            svc-url := LineEdit { placeholder-text: "https://..."; horizontal-stretch: 1; }
                            Pill { icon-d: Icons.add; label: "Añadir"; y: 2px; clicked => { root.add-service(svc-name.text, svc-url.text); svc-name.text = ""; svc-url.text = ""; } }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        content-height: Math.ceil(root.services.length / root.scols) * 104px + 12px;
                        for s[i] in root.services: Rectangle {
                            x: Math.mod(i, root.scols) * root.scell-w;
                            y: Math.floor(i / root.scols) * 104px;
                            width: root.scell-w - 12px;
                            height: 92px;
                            background: Theme.surface;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding: 16px;
                                spacing: 12px;
                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 14px;
                                    background: Theme.container;
                                    Text { text: s.initial; color: Theme.on-container; font-size: 20px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: s.name; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                                    Text { text: s.has-session ? "Sesión guardada" : "Sin iniciar sesión"; color: s.has-session ? Theme.ok : Theme.muted; font-size: 12px; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Pill { label: "Abrir"; height: 32px; min-width: 84px; clicked => { root.web-open(i); } }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        if s.has-session: Pill { label: "Olvidar"; kind: 3; height: 26px; min-width: 60px; clicked => { root.web-forget(i); } }
                                        if s.custom: Pill { label: "Quitar"; kind: 3; height: 26px; min-width: 60px; clicked => { root.remove-service(i); } }
                                    }
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------------ Móviles y ajustes
                if root.page == 6: ScrollView {
                    GridLayout {
                        spacing: 14px;
                        padding-right: 10px;
                        Card {
                            row: 0; col: 0;
                            title: "Móviles vinculados";
                            subtitle: "Los móviles que pueden abrir SyncroUmbral. Para añadir uno nuevo, genera un código y escanéalo desde la app del móvil.";
                            if root.devices.length == 0: Text { text: "Aún no hay ningún móvil vinculado."; color: Theme.muted; }
                            for d in root.devices: HorizontalLayout {
                                spacing: 12px;
                                height: 38px;
                                Icon { d: Icons.phone-android; tint: Theme.primary; y: 9px; }
                                Text { text: d.name; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Pill { label: "Quitar"; kind: 3; height: 30px; min-width: 70px; y: 4px; clicked => { root.remove-device(d.id); } }
                            }
                            HorizontalLayout {
                                spacing: 18px;
                                Rectangle {
                                    width: 200px;
                                    height: 200px;
                                    border-radius: 12px;
                                    background: root.qr.width > 0 ? white : Theme.surface2;
                                    if root.qr.width > 0: Image { source: root.qr; width: parent.width - 12px; height: parent.height - 12px; x: 6px; y: 6px; image-rendering: pixelated; }
                                    if root.qr.width == 0: Text { text: "Código QR"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout {
                                    spacing: 10px;
                                    alignment: center;
                                    Text { text: "Abre SyncroUmbral en el móvil, toca «Escanear QR del PC» y apunta a este código. Vale 5 minutos."; color: Theme.muted; wrap: word-wrap; }
                                    Text { text: root.qr-text; color: Theme.text; wrap: word-wrap; }
                                    HorizontalLayout {
                                        alignment: start;
                                        spacing: 10px;
                                        Pill { label: "Generar código"; clicked => { root.make-qr(); } }
                                        Pill { icon-d: Icons.copy; label: "Copiar el código"; kind: 1; clicked => { root.copy-pairing(); } }
                                    }
                                    Text { text: "¿Sin cámara? Copia el código y pégalo en «Vincular con el código» de la app del móvil."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                        }
                        Card {
                            row: 1; col: 0;
                            title: "Funcionamiento";
                            subtitle: "Cómo arranca y se comporta SyncroUmbral en el PC.";
                            SwitchRow { label: "Iniciar con Windows"; hint: "Arranca en segundo plano (solo el icono de la bandeja) para que el móvil desbloquee el PC sin abrir nada."; checked <=> root.autostart; toggled(v) => { root.toggled-autostart(v); } }
                            if root.autostart-status != "": HorizontalLayout {
                                spacing: 10px;
                                Text { text: root.autostart-status; color: root.autostart-problem ? Theme.bad : Theme.muted; font-size: 12px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                if root.autostart-problem: Pill { icon-d: Icons.settings; label: "Abrir Inicio de Windows"; kind: 1; clicked => { root.open-startup-settings(); } }
                            }
                            SwitchRow { label: "Silenciar el resto de sonidos en llamadas"; hint: "Mientras suena una llamada baja el volumen de las demás apps. No toca FxSound ni Voicemeeter."; checked <=> root.mute-on-call; toggled(v) => { root.toggled-mute(v); } }
                            SwitchRow { label: "Modo completo"; hint: "Permite abrir apps del móvil en el PC (usa adb y scrcpy). Pide activar la depuración en el móvil."; checked <=> root.advanced; toggled(v) => { root.toggled-advanced(v); } }
                        }
                        Card {
                            row: root.wide ? 0 : 2; col: root.wide ? 1 : 0;
                            title: "Seguridad y avisos";
                            subtitle: "Qué se ve y cuándo se protege el PC.";
                            SwitchRow { label: "Bloquear Windows al alejarte"; hint: "Pasados 15 s sin el móvil se bloquea la sesión de Windows; se abre con tu clave de Windows."; checked <=> root.lock-windows; toggled(v) => { root.toggled-lock-windows(v); } }
                            SwitchRow { label: "Ocultar el contenido de los avisos"; hint: "Los avisos muestran solo la app. Útil al compartir pantalla."; checked <=> root.hide-content; toggled(v) => { root.toggled-hide(v); } }
                            Text { text: "Silenciar avisos emergentes con estas palabras"; color: Theme.text; }
                            Text { text: "Separadas por comas. Las notificaciones siguen en la lista, pero no saltan en pantalla."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            LineEdit { text <=> root.mute-words; placeholder-text: "oferta, promoción, sorteo"; edited(t) => { root.mute-words-edited(t); } }
                        }
                        Card {
                            row: root.wide ? 1 : 3; col: root.wide ? 1 : 0;
                            title: "Copias y envío rápido";
                            subtitle: "Atajos para mover cosas entre el móvil y el PC.";
                            SwitchRow { label: "Copia automática de las fotos nuevas"; hint: "Solo las que hagas desde que lo actives; se guardan en Imágenes\\SyncroUmbral\\Copia."; checked <=> root.photo-backup; toggled(v) => { root.toggled-backup(v); } }
                            Text { text: "Clic derecho en un archivo: «Enviar al móvil con SyncroUmbral»."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Pill { label: "Añadir al menú del Explorador"; kind: 1; clicked => { root.context-menu(true); } }
                                Pill { label: "Quitarlo"; kind: 2; clicked => { root.context-menu(false); } }
                            }
                        }
                        Card {
                            row: root.wide ? 2 : 4; col: 0;
                            title: "Acciones del móvil";
                            subtitle: "También disponibles arriba en cualquier página.";
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Pill { icon-d: Icons.sound; label: root.ringing ? "Parar de sonar" : "Hacer sonar el móvil"; kind: root.ringing ? 5 : 1; clicked => { root.ring-phone(!root.ringing); } }
                                Pill { icon-d: Icons.clipboard; label: "Portapapeles al móvil"; kind: 1; clicked => { root.send-clipboard(); } }
                            }
                            Text { text: "El móvil suena al máximo aunque esté en silencio, hasta 1 minuto. Para llevar el portapapeles del móvil al PC, usa el botón «Copiar al PC» de la notificación permanente de SyncroUmbral."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        }
                        Card {
                            row: root.wide ? 2 : 5; col: root.wide ? 1 : 0;
                            title: "Herramientas";
                            subtitle: "adb y scrcpy los usa el modo completo. SyncroUmbral los descarga con su huella verificada.";
                            Text { text: root.tools-text; color: Theme.text; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Pill { label: "Instalar adb"; kind: 1; clicked => { root.install-tool("adb"); } }
                                Pill { label: "Instalar scrcpy"; kind: 1; clicked => { root.install-tool("scrcpy"); } }
                            }
                        }
                        Card {
                            row: root.wide ? 3 : 7; col: root.wide ? 1 : 0;
                            title: "Espacio en disco";
                            subtitle: "Lo que SyncroUmbral guarda en tu usuario (claves, ajustes y sesiones de mensajería).";
                            Text { text: root.disk-text; color: Theme.text; wrap: word-wrap; }
                            if root.old-data-exists: VerticalLayout {
                                spacing: 8px;
                                Text { text: root.old-data-text; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Pill {
                                        icon-d: Icons.close;
                                        label: root.old-data-confirm ? "Sí, borrar ahora" : "Borrar datos de la versión anterior";
                                        kind: root.old-data-confirm ? 5 : 1;
                                        clicked => {
                                            if (root.old-data-confirm) { root.old-data-confirm = false; root.delete-old-data(); } else { root.old-data-confirm = true; }
                                        }
                                    }
                                    if root.old-data-confirm: Pill { label: "Cancelar"; kind: 1; clicked => { root.old-data-confirm = false; } }
                                }
                            }
                        }
                        Card {
                            row: root.wide ? 3 : 6; col: 0;
                            title: "Acerca de SyncroUmbral";
                            subtitle: "Software libre (GPL-3.0 o posterior). Solo usa su red local; las actualizaciones vienen firmadas desde GitHub.";
                            HorizontalLayout {
                                spacing: 10px;
                                Icon { d: Icons.info; tint: Theme.primary; width: 22px; height: 22px; y: 2px; }
                                Text { text: "Versión " + root.app-version; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Pill { icon-d: Icons.refresh; label: "Buscar actualizaciones"; kind: 1; clicked => { root.check-updates(); } }
                                Pill { icon-d: Icons.info; label: "Novedades de esta versión"; kind: 1; clicked => { root.show-whats-new(); } }
                                Pill { icon-d: Icons.open-in-new; label: "Todas las versiones"; kind: 1; clicked => { root.open-link("https://github.com/juandr404/syncroumbral/releases"); } }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Pill { icon-d: Icons.open-in-new; label: "Página web"; kind: 1; clicked => { root.open-link("https://www.syncroapp.dev/umbral/"); } }
                                Pill { icon-d: Icons.open-in-new; label: "Código en GitHub"; kind: 1; clicked => { root.open-link("https://github.com/juandr404/syncroumbral"); } }
                                Pill { icon-d: Icons.open-in-new; label: "Privacidad"; kind: 1; clicked => { root.open-link("https://www.syncroapp.dev/umbral/privacidad"); } }
                            }
                        }
                    }
                }

                // Mensaje de estado (barra inferior)
                if root.status != "": Rectangle {
                    height: 34px;
                    border-radius: 17px;
                    background: Theme.surface3;
                    Text { x: 16px; text: root.status; color: Theme.text; vertical-alignment: center; overflow: elide; width: parent.width - 32px; }
                }
            }
        }

        // ------------------------------------------------------------ panel derecho (pantallas grandes)
        if root.rail: Rectangle {
            width: 330px;
            VerticalLayout {
                padding-top: 24px;
                padding-right: 20px;
                padding-bottom: 14px;
                spacing: 14px;
                Rectangle {
                    background: Theme.surface;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: Theme.border;
                    height: 150px;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 10px;
                            Icon { d: Icons.phone-android; tint: root.present ? Theme.ok : Theme.muted; width: 24px; height: 24px; }
                            Text { text: root.present ? root.device : "Móvil ausente"; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                        }
                        Text { text: root.battery >= 0 ? root.battery + "%" : "—"; color: Theme.text; font-size: 34px; font-weight: 600; }
                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.surface3;
                            Rectangle { x: 0px; width: parent.width * (root.battery < 0 ? 0 : root.battery) / 100; border-radius: 3px; background: root.battery >= 0 && root.battery <= 20 ? Theme.bad : Theme.ok; }
                        }
                        Text { text: root.present ? (root.charging ? "Cargando" : "Conectado") : "Sesión abierta con clave"; color: Theme.muted; font-size: 12px; }
                    }
                }
                Rectangle {
                    background: Theme.surface;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: Theme.border;
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 4px;
                        alignment: start;
                        Text { text: "Acciones rápidas"; color: Theme.text; font-size: 15px; font-weight: 600; }
                        QuickAction { icon-d: Icons.clipboard; title: "Portapapeles al móvil"; hint: "Copia lo que tengas en el PC al móvil"; clicked => { root.send-clipboard(); } }
                        QuickAction { icon-d: Icons.sound; title: root.ringing ? "Parar de sonar" : "Hacer sonar el móvil"; hint: "Suena al máximo hasta 1 minuto"; active: root.ringing; clicked => { root.ring-phone(!root.ringing); } }
                        QuickAction { icon-d: Icons.folder; title: "Enviar archivos"; hint: "Ve a Archivos o arrástralos a la ventana"; clicked => { root.page = 0; root.page-changed(0); } }
                        QuickAction { icon-d: Icons.image; title: "Ver la galería"; hint: "Fotos y vídeos por álbum"; clicked => { root.page = 2; root.page-changed(2); } }
                        QuickAction { icon-d: Icons.copy; title: "Del móvil al PC"; hint: "Botón «Copiar al PC» en la notificación del móvil"; clicked => { } }
                        Rectangle { height: 8px; }
                        // Zona de envío: se ilumina al arrastrar un archivo sobre la ventana y dice dónde quedará cada cosa.
                        Rectangle {
                            border-radius: 16px;
                            background: root.dragging ? #12404a : Theme.surface2;
                            border-width: root.dragging ? 2px : 1.5px;
                            border-color: root.dragging ? Theme.primary : Theme.line;
                            animate background { duration: 120ms; }
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Icon { d: Icons.upload; tint: root.dragging ? Theme.primary : Theme.muted; y: 1px; }
                                    Text { text: root.dragging ? "Suelta para enviar al móvil" : "Arrastra archivos aquí"; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                }
                                Text { text: "Suéltalos desde el Explorador en cualquier parte de la ventana."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                Rectangle { height: 1px; background: Theme.border; }
                                Text { text: "Dónde quedan"; color: Theme.muted; font-size: 11px; font-weight: 600; }
                                Text { text: "Al móvil: " + (root.phone-path == "" ? "Almacenamiento interno" : root.phone-path) + ". Es la carpeta del móvil que tengas abierta en Archivos."; color: Theme.text; font-size: 12px; wrap: word-wrap; }
                                Text { text: "Del móvil al PC: Descargas\\SyncroUmbral, lo que compartes o copias desde el móvil."; color: Theme.text; font-size: 12px; wrap: word-wrap; }
                                Text { text: "Con «Traer al PC»: " + (root.pc-path == "" ? "la carpeta abierta de Este PC" : root.pc-path) + "."; color: Theme.text; font-size: 12px; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
        }
    }

    // Panel de novedades: se abre solo tras actualizar y desde Acerca de.
    if root.whats-new != "": Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #000000b0;
        TouchArea { clicked => { root.whats-new = ""; } }
        Rectangle {
            width: min(720px, parent.width - 48px);
            height: min(560px, parent.height - 48px);
            border-radius: 20px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea { }
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 10px;
                    Icon { d: Icons.check; tint: Theme.ok; width: 24px; height: 24px; y: 2px; }
                    Text { text: "Novedades de la versión " + root.app-version; color: Theme.text; font-size: 20px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                }
                Rectangle { height: 1px; background: Theme.border; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        Text { text: root.whats-new; color: Theme.text; font-size: 14px; wrap: word-wrap; }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Pill { icon-d: Icons.open-in-new; label: "Todas las versiones"; kind: 1; clicked => { root.open-link("https://github.com/juandr404/syncroumbral/releases"); } }
                    Pill { icon-d: Icons.check; label: "Entendido"; clicked => { root.whats-new = ""; root.updated-text = ""; } }
                }
            }
        }
    }
}
