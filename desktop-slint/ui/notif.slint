import { LineEdit } from "std-widgets.slint";
import { Theme, Notif, Pill } from "common.slint";

// Tarjeta de notificación: fila de 64 px (icono, título y app, texto, hora, descartar) y, si procede, caja de respuesta y botones de llamada.
export component NotifCard inherits Rectangle {
    in property <Notif> n;
    in property <string> status;
    callback dismissed();
    callback reply(string);
    callback answer();
    callback end();
    callback action(int);
    callback copy-code(string);
    background: card-touch.has-hover ? Theme.surface2 : Theme.surface;
    border-radius: 16px;
    height: 64px + (n.reply-index >= 0 ? 46px : 0px) + (n.call ? 48px : 0px) + (n.actions.length > 0 && !n.call ? 42px : 0px) + (n.code != "" ? 42px : 0px);
    animate background { duration: 120ms; }
    card-touch := TouchArea { }
    VerticalLayout {
        padding-left: 14px;
        padding-right: 8px;
        padding-top: 10px;
        padding-bottom: 8px;
        spacing: 8px;
        HorizontalLayout {
            height: 44px;
            spacing: 12px;
            Rectangle {
                width: 36px;
                height: 36px;
                y: 4px;
                border-radius: 18px;
                background: n.call ? (n.incoming ? #1f5e2a : Theme.container) : Theme.container;
                Text { text: n.call ? "☎" : "!"; color: Theme.on-container; font-size: 16px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            VerticalLayout {
                spacing: 1px;
                horizontal-stretch: 1;
                alignment: center;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: n.call ? (n.incoming ? "Llamada entrante" : "Llamada en curso") : n.title; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; horizontal-stretch: 0; }
                    Text { text: n.app; color: Theme.muted; font-size: 12px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: n.time; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                }
                Text { text: n.call ? n.title : n.text; color: Theme.muted; font-size: 13px; overflow: elide; }
            }
            Rectangle {
                width: 32px;
                height: 32px;
                y: 6px;
                border-radius: 16px;
                background: x-touch.has-hover ? Theme.surface3 : transparent;
                Text { text: "×"; color: Theme.muted; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                x-touch := TouchArea { mouse-cursor: pointer; clicked => { root.dismissed(); } }
            }
        }
        if n.reply-index >= 0: HorizontalLayout {
            spacing: 8px;
            padding-right: 6px;
            height: 38px;
            input := LineEdit {
                placeholder-text: n.reply-hint == "" ? "Responder" : n.reply-hint;
                accepted(t) => { root.reply(t); self.text = ""; }
            }
            Pill { label: "Enviar"; kind: 1; height: 34px; min-width: 70px; y: 2px; clicked => { root.reply(input.text); input.text = ""; } }
        }
        if n.code != "": HorizontalLayout {
            spacing: 8px;
            height: 34px;
            alignment: start;
            Pill { label: "Copiar código " + n.code; kind: 4; height: 32px; clicked => { root.copy-code(n.code); } }
        }
        if n.actions.length > 0 && !n.call: HorizontalLayout {
            spacing: 8px;
            height: 34px;
            alignment: start;
            for a in n.actions: Pill { label: a.title; kind: 1; height: 32px; min-width: 60px; clicked => { root.action(a.index); } }
        }
        if n.call: HorizontalLayout {
            spacing: 10px;
            height: 40px;
            alignment: start;
            if n.incoming: Pill { label: "Contestar"; kind: 4; clicked => { root.answer(); } }
            Pill { label: n.incoming ? "Rechazar" : "Colgar"; kind: 5; clicked => { root.end(); } }
            Text { text: root.status; color: Theme.muted; vertical-alignment: center; overflow: elide; }
        }
    }
}
