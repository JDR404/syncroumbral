// Icono vectorial de 24x24 teñido con el color indicado.
export component Icon inherits Path {
    in property <string> d;
    in property <color> tint: Theme.muted;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.tint;
    commands: root.d;
}



export struct FileItem {
    name: string,
    meta: string,
    dir: bool,
    selected: bool,
    /// 1 imagen, 2 vídeo, 0 cualquier otro archivo.
    kind: int,
    has-thumb: bool,
    thumb: image,
}

export struct NotifAction {
    index: int,
    title: string,
}

export struct Photo {
    path: string,
    name: string,
    video: bool,
    selected: bool,
    has-thumb: bool,
    thumb: image,
}

export struct ContactItem {
    name: string,
    number: string,
}

export struct CallItem {
    title: string,
    detail: string,
    number: string,
    /// 1 entrante, 2 saliente, 3 perdida
    kind: int,
}

export struct ThreadItem {
    title: string,
    address: string,
    snippet: string,
    time: string,
    unread: bool,
}

export struct MsgItem {
    text: string,
    mine: bool,
    time: string,
}

export struct Notif {
    key: string,
    app: string,
    title: string,
    text: string,
    time: string,
    call: bool,
    incoming: bool,
    /// Índice de la acción de responder (-1 si no se puede responder).
    reply-index: int,
    reply-hint: string,
    /// Código de verificación detectado en el texto (vacío si no hay).
    code: string,
    /// Botones de la notificación (reproductor, etc.), sin los de responder ni los de llamada.
    actions: [NotifAction],
}

export struct AppItem {
    pkg: string,
    label: string,
    system: bool,
    open: bool,
    has-icon: bool,
    icon: image,
}

export struct AlbumItem {
    name: string,
    count: int,
    selected: bool,
}

export struct DeviceItem {
    id: string,
    name: string,
}

export struct ServiceItem {
    id: string,
    name: string,
    url: string,
    initial: string,
    has-session: bool,
    custom: bool,
}

// Botón en forma de píldora. kind: 0 principal, 1 tonal, 2 contorno, 3 peligro.
export component Pill inherits Rectangle {
    in property <string> label;
    in property <string> icon-d;
    in property <int> kind: 0;
    in property <bool> enabled: true;
    // Explicación del botón: se muestra bajo el título de la página mientras el ratón está encima.
    in property <string> hint;
    callback clicked();
    callback hovered(string);
    height: 36px;
    min-width: root.label == "" ? 40px : 84px;
    horizontal-stretch: 0;
    border-radius: 18px;
    background: kind == 0 ? Theme.primary
        : kind == 1 ? #0c5c66
        : kind == 4 ? #1f5e2a
        : kind == 5 ? #8c3a34
        : touch.has-hover ? Theme.surface2 : transparent;
    border-width: (kind == 2 || kind == 3) ? 1px : 0px;
    border-color: kind == 3 ? #8c3a34 : Theme.line;
    opacity: enabled ? 1.0 : 0.4;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: root.label == "" ? 12px : 18px;
        padding-right: root.label == "" ? 12px : 18px;
        spacing: 8px;
        alignment: center;
        if root.icon-d != "": Icon {
            d: root.icon-d;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            tint: kind == 0 ? Theme.on-primary : kind == 1 ? #b7f1fa : kind == 3 ? Theme.bad : Theme.text;
        }
        if root.label != "": Text {
            text: root.label;
            color: kind == 0 ? Theme.on-primary : kind == 1 ? #b7f1fa : kind == 3 ? Theme.bad : Theme.text;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        // Al pasar el ratón se anuncia la explicación; al salir se anuncia vacía.
        changed has-hover => { root.hovered(self.has-hover ? root.hint : ""); }
    }
}

// Interruptor con la paleta de la aplicación.
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: checked ? Theme.primary : Theme.surface3;
    border-width: checked ? 0px : 1px;
    border-color: Theme.line;
    animate background { duration: 120ms; }
    Rectangle {
        y: 3px;
        x: root.checked ? 23px : 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? Theme.on-primary : Theme.muted;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
}

// Fila de ajuste: texto a la izquierda e interruptor a la derecha.
export component SwitchRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in-out property <bool> checked;
    callback toggled(bool);
    min-height: hint == "" ? 44px : 58px;
    HorizontalLayout {
        spacing: 16px;
        padding-top: 4px;
        padding-bottom: 4px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.label; color: Theme.text; overflow: elide; }
            if root.hint != "": Text { text: root.hint; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        }
        Toggle {
            y: (parent.height - self.height) / 2;
            checked <=> root.checked;
            toggled(v) => { root.toggled(v); }
        }
    }
}

// Elemento del menú lateral: icono y texto; plegado, solo el icono con un punto si hay avisos.
export component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon-d;
    in property <bool> active;
    in property <bool> collapsed;
    in property <int> badge: 0;
    callback clicked();
    height: 46px;
    border-radius: 23px;
    background: active ? Theme.container : touch.has-hover ? Theme.surface : transparent;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: root.collapsed ? 0px : 16px;
        padding-right: 12px;
        spacing: 14px;
        alignment: root.collapsed ? center : start;
        Icon { d: root.icon-d; tint: active ? Theme.on-container : Theme.muted; y: (parent.height - self.height) / 2; }
        if !root.collapsed: Text {
            text: root.label;
            color: active ? Theme.on-container : Theme.text;
            font-size: 14px;
            font-weight: active ? 600 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.badge > 0 && !root.collapsed: Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 11px;
            background: Theme.bad;
            Text { text: root.badge; color: #410002; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    if root.badge > 0 && root.collapsed: Rectangle {
        x: parent.width - 18px;
        y: 8px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.bad;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component FileRow inherits Rectangle {
    in property <FileItem> item;
    callback toggled();
    callback opened();
    height: 46px;
    border-radius: 12px;
    background: item.selected ? Theme.container : touch.has-hover ? Theme.surface2 : transparent;
    // Una carpeta se abre con un clic; un archivo se marca con un clic. La casilla de la izquierda marca cualquiera de los dos.
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { if item.dir { root.opened(); } else { root.toggled(); } }
        double-clicked => { root.opened(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 24px;
        spacing: 10px;
        Rectangle {
            width: 28px;
            Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                background: item.selected ? Theme.primary : transparent;
                border-width: item.selected ? 0px : 1.5px;
                border-color: Theme.muted;
                if item.selected: Icon { d: Icons.check; tint: Theme.on-primary; x: 2px; y: 2px; width: 16px; height: 16px; }
            }
            box := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
        }
        Rectangle {
            width: 34px;
            Rectangle {
                width: 34px;
                height: 34px;
                y: (parent.height - self.height) / 2;
                border-radius: 8px;
                background: item.has-thumb ? Theme.surface3 : transparent;
                clip: true;
                if item.has-thumb: Image { source: item.thumb; width: parent.width; height: parent.height; image-fit: cover; }
                if !item.has-thumb: Icon {
                    d: item.dir ? Icons.folder : item.kind == 2 ? Icons.play : item.kind == 1 ? Icons.image : Icons.file;
                    tint: item.dir ? Theme.folder : Theme.muted;
                    x: 7px;
                    y: 7px;
                }
            }
        }
        Text {
            text: item.name;
            color: item.selected ? Theme.on-container : Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: item.meta;
            color: item.selected ? Theme.on-container : Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

// Casilla de un elemento del modo cuadrícula: vista previa grande, nombre completo al pasar el ratón.
export component FileTile inherits Rectangle {
    in property <FileItem> item;
    callback toggled();
    callback opened();
    border-radius: 12px;
    background: Theme.surface2;
    clip: true;
    if item.has-thumb: Image { source: item.thumb; width: parent.width; height: parent.height; image-fit: cover; }
    if !item.has-thumb: VerticalLayout {
        padding: 8px;
        spacing: 6px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Icon {
                d: item.dir ? Icons.folder : item.kind == 2 ? Icons.play : item.kind == 1 ? Icons.image : Icons.file;
                tint: item.dir ? Theme.folder : Theme.muted;
                width: 36px;
                height: 36px;
            }
        }
        Text { text: item.name; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-alignment: center; overflow: elide; height: 30px; }
    }
    // Clic: una carpeta se abre y un archivo se marca. La casilla de la esquina marca cualquiera de los dos.
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { if item.dir { root.opened(); } else { root.toggled(); } }
        double-clicked => { root.opened(); }
    }
    if item.has-thumb && item.kind == 2: Rectangle {
        x: parent.width - 32px;
        y: 8px;
        width: 24px;
        height: 22px;
        border-radius: 6px;
        background: #000000a0;
        Text { text: "▶"; color: white; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
    }
    if touch.has-hover: Rectangle {
        y: parent.height - self.height;
        height: name-label.preferred-height + (item.meta != "" ? 22px : 12px);
        background: #000000c8;
        name-label := Text { x: 8px; y: 6px; width: parent.width - 16px; text: item.name; color: white; font-size: 11px; font-weight: 500; wrap: word-wrap; }
        if item.meta != "": Text { x: 8px; y: name-label.y + name-label.preferred-height + 2px; width: parent.width - 16px; text: item.meta; color: #d0d6d8; font-size: 10px; overflow: elide; }
    }
    Rectangle { border-radius: 12px; border-width: item.selected ? 3px : 0px; border-color: Theme.primary; background: item.selected ? #4fd8eb30 : transparent; }
    if touch.has-hover || item.selected: Rectangle {
        x: 6px;
        y: 6px;
        width: 22px;
        height: 22px;
        border-radius: 7px;
        background: item.selected ? Theme.primary : #000000b0;
        border-width: item.selected ? 0px : 1.5px;
        border-color: white;
        if item.selected: Icon { d: Icons.check; tint: Theme.on-primary; x: 3px; y: 3px; width: 16px; height: 16px; }
        TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
    }
}

export component Pane inherits Rectangle {
    in property <string> title;
    in property <string> path;
    in property <[FileItem]> files;
    in property <string> footer;
    in property <string> message;
    in-out property <bool> grid: false;
    callback toggled(int);
    callback opened(int);
    callback up();
    callback refresh();
    in-out property <string> filter-text;
    callback filter(string);
    callback select-all();
    property <int> cols: Math.max(1, Math.floor((root.width - 20px) / 118px));
    property <length> cell: (root.width - 20px) / root.cols;
    background: Theme.surface;
    border-radius: 20px;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    VerticalLayout {
        padding-top: 14px;
        spacing: 6px;
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 14px;
            spacing: 8px;
            Text { text: root.title; font-size: 16px; font-weight: 600; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            Pill { icon-d: root.grid ? Icons.view-list : Icons.view-grid; label: ""; kind: 1; height: 32px; clicked => { root.grid = !root.grid; } }
            Pill { icon-d: Icons.left; label: "Subir"; kind: 1; height: 32px; min-width: 70px; clicked => { root.up(); } }
            Pill { icon-d: Icons.refresh; label: ""; kind: 1; height: 32px; clicked => { root.refresh(); } }
        }
        HorizontalLayout { padding-left: 18px; padding-right: 14px; height: 14px; Text { text: root.path; font-size: 11px; color: Theme.muted; overflow: elide; } }
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 8px;
            LineEdit { text <=> root.filter-text; placeholder-text: "Filtrar por nombre"; edited(t) => { root.filter(t); } }
            Pill { label: "Marcar todo"; kind: 2; height: 32px; min-width: 100px; y: 2px; clicked => { root.select-all(); } }
        }
        if root.message != "": Rectangle {
            vertical-stretch: 1;
            Text {
                x: 24px;
                width: parent.width - 48px;
                text: root.message;
                color: Theme.bad;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
                height: parent.height;
            }
        }
        if root.message == "" && !root.grid: ListView {
            vertical-stretch: 1;
            for item[i] in root.files: FileRow {
                item: item;
                toggled => { root.toggled(i); }
                opened => { root.opened(i); }
            }
        }
        if root.message == "" && root.grid: ScrollView {
            vertical-stretch: 1;
            content-height: Math.ceil(root.files.length / root.cols) * root.cell + 8px;
            for item[i] in root.files: FileTile {
                x: Math.mod(i, root.cols) * root.cell + 10px;
                y: Math.floor(i / root.cols) * root.cell + 4px;
                width: root.cell - 8px;
                height: root.cell - 8px;
                item: item;
                toggled => { root.toggled(i); }
                opened => { root.opened(i); }
            }
        }
        Rectangle {
            height: 34px;
            Text { x: 18px; text: root.footer; color: Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide; width: parent.width - 40px; }
        }
    }
}
