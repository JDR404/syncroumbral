import { ListView, LineEdit, ScrollView } from "std-widgets.slint";
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
// Piezas comunes de la interfaz nativa de SyncroUmbral: paleta, tipos de datos y componentes sueltos.
export global Theme {
    out property <color> bg: #0e1415;
    out property <color> surface: #171d1e;
    out property <color> surface2: #1f2a2c;
    out property <color> surface3: #2a3638;
    out property <color> line: #3f4849;
    out property <color> text: #dee3e5;
    out property <color> muted: #a3adaf;
    out property <color> primary: #4fd8eb;
    out property <color> on-primary: #00363d;
    out property <color> container: #004f58;
    out property <color> on-container: #97f0ff;
    out property <color> ok: #78dc77;
    out property <color> bad: #ffb4ab;
    out property <color> folder: #f2b93b;
    out property <color> border: #263234;
}


